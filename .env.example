# Copiar a .env (Copy-Item .env.example .env) y completar. NUNCA versionar .env.

# --- Puertos de host (cambiar si hay choques en Windows) ---
# Si tenés un PostgreSQL nativo en el 5432, usá 5433 acá y en CORE_DB_URL (más abajo)
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
KEYCLOAK_PORT=8180

# --- PostgreSQL (superusuario del contenedor) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# --- Usuarios por servicio (los crea infra/postgres/init.sql) ---
CORE_DB_USER=core_user
CORE_DB_PASSWORD=change-me-core
TX_DB_USER=tx_user
TX_DB_PASSWORD=change-me-tx
FRAUD_DB_USER=fraud_user
FRAUD_DB_PASSWORD=change-me-fraud

# --- Core-Banking (cuando corre fuera de Docker) ---
CORE_DB_URL=jdbc:postgresql://localhost:5432/core_db
# 32 bytes en base64. Generar: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }) -as [byte[]])
APP_CRYPTO_KEY=change-me-base64-32-bytes

# --- RabbitMQ ---
RABBITMQ_USER=fintech
RABBITMQ_PASSWORD=change-me-rabbit

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-kc-admin

# --- Usuarios del realm fintech (solo desarrollo) ---
KC_USER1_PASSWORD=change-me-user1
KC_USER2_PASSWORD=change-me-user2
KC_ADMIN_USER_PASSWORD=change-me-admin
